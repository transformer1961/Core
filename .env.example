# Copy to .env for local Netlify development
# The site reads these when running under Netlify Dev.
BOT_WEBHOOK_SECRET=replace_with_a_long_random_secret
SNS_ADMIN_KEY=replace_with_a_separate_owner_api_key
SESSION_SECRET=replace_with_a_long_random_session_secret
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=http://localhost:8888/api/auth/callback
SNS_OWNER_IDS=your_discord_user_id
# Optional alternative to SNS_OWNER_IDS: comma-separated guild IDs where the user is the owner.
SNS_ALLOWED_GUILD_IDS=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sns_core
