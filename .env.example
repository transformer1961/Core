# Copy to .env for local Netlify development only.
# For Netlify, add these names under Site configuration -> Environment variables.
# Generate each secret as a cryptographically secure random 32-byte value.

# Shared with SNSCore and Watchtower bot webhook clients.
BOT_WEBHOOK_SECRET=replace_with_shared_webhook_secret
# Separate key for owner-only command endpoints.
SNS_ADMIN_KEY=replace_with_owner_api_key
SESSION_SECRET=replace_with_random_session_secret

# Discord Developer Portal -> OAuth2 -> General -> Client ID/Secret.
DISCORD_CLIENT_ID=replace_with_discord_application_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
# Local: http://localhost:8888/api/auth/callback
# Production: https://your-netlify-site.netlify.app/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8888/api/auth/callback

# Enable Discord Developer Mode, then copy user IDs.
SNS_OWNER_IDS=replace_with_owner_discord_user_id
SNS_STAFF_IDS=comma_separated_discord_staff_user_ids
# Create this key for bot enrollment; keep it separate from BOT_WEBHOOK_SECRET.
SNS_ENROLLMENT_KEY=replace_with_bot_enrollment_key
# Optional comma-separated guild IDs whose owners may be treated as SNS owners.
SNS_ALLOWED_GUILD_IDS=

# MongoDB Atlas -> Database -> Connect -> Drivers -> Node.js connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sns_core
